<Window x:Class="UselessAI.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="USELESS AI" Width="390" Height="510" WindowStyle="None" AllowsTransparency="True"
 Background="Transparent" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False"
 Loaded="Window_Loaded" Deactivated="Window_Deactivated" Closing="Window_Closing">
 <Grid>
  <Border x:Name="Shell" Background="#F908090D" BorderBrush="#FF2A2E39" BorderThickness="1" CornerRadius="27" Padding="12">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="50"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid x:Name="Header" MouseLeftButtonDown="Header_MouseLeftButtonDown">
     <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
     <Button Grid.Column="0" Style="{StaticResource RoundButton}" Click="MascotButton_Click" ToolTip="Buka panel"><Grid><Border Width="29" Height="27" CornerRadius="9" Background="#FFE8F0FF"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><Ellipse Width="4" Height="7" Fill="#FF18243B" Margin="3,0"/><Ellipse Width="4" Height="7" Fill="#FF18243B" Margin="3,0"/></StackPanel></Border></Grid></Button>
     <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0"><TextBlock Text="USELESS AI" FontSize="11" FontWeight="Bold" Foreground="#FFF5F6FA" CharacterSpacing="160"/><TextBlock x:Name="StatusText" Text="Siap membantu kamu" FontSize="10" Foreground="#FF8D94A5" Margin="0,3,0,0"/></StackPanel>
     <Button Grid.Column="2" Style="{StaticResource RoundButton}" Content="⚙" Click="Settings_Click" ToolTip="Pengaturan"/>
     <Button Grid.Column="3" Style="{StaticResource RoundButton}" Content="−" Click="Minimize_Click" ToolTip="Minimalkan"/>
    </Grid>
    <Grid Grid.Row="1" x:Name="Body">
     <Grid.RowDefinitions><RowDefinition Height="62"/><RowDefinition Height="76"/><RowDefinition Height="32"/><RowDefinition Height="*"/><RowDefinition Height="42"/><RowDefinition Height="18"/></Grid.RowDefinitions>
     <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
      <Border Width="48" Height="48" CornerRadius="16" Background="#FF171B26" BorderBrush="#FF30394A" BorderThickness="1" Margin="2,0,12,0"><Grid><Border Width="31" Height="28" CornerRadius="9" Background="#FFE7F0FF" VerticalAlignment="Center" HorizontalAlignment="Center"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><Ellipse Width="4" Height="8" Fill="#FF18243B" Margin="4,0"/><Ellipse Width="4" Height="8" Fill="#FF18243B" Margin="4,0"/></StackPanel></Border><TextBlock Text="✦" Foreground="#FFA8C8FF" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Top"/></Grid></Border>
      <StackPanel VerticalAlignment="Center"><TextBlock Text="Hai, aku Useless AI." Foreground="#FFF5F6FA" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="Mau dibantu apa hari ini?" Foreground="#FF8D94A5" FontSize="11" Margin="0,4,0,0"/></StackPanel>
     </StackPanel>
     <UniformGrid Grid.Row="1" Columns="3" Margin="0,4,0,8">
      <Button Style="{StaticResource ToolButton}" Click="Scan_Click"><StackPanel><TextBlock Text="▣" Foreground="#FFA8C8FF" FontSize="18"/><TextBlock Text="Scan layar" FontWeight="SemiBold" FontSize="10" Margin="0,4,0,0"/><TextBlock Text="Pilih area" Foreground="#FF858B9B" FontSize="9" Margin="0,3,0,0"/></StackPanel></Button>
      <Button Style="{StaticResource ToolButton}" Click="Coding_Click"><StackPanel><TextBlock Text="⌘" Foreground="#FFA8C8FF" FontSize="18"/><TextBlock Text="Bantu coding" FontWeight="SemiBold" FontSize="10" Margin="0,4,0,0"/><TextBlock Text="Buka file" Foreground="#FF858B9B" FontSize="9" Margin="0,3,0,0"/></StackPanel></Button>
      <Button Style="{StaticResource ToolButton}" Click="Listen_Click"><StackPanel><TextBlock Text="◖" Foreground="#FFA8C8FF" FontSize="18"/><TextBlock Text="Bicara" FontWeight="SemiBold" FontSize="10" Margin="0,4,0,0"/><TextBlock Text="Voice input" Foreground="#FF858B9B" FontSize="9" Margin="0,3,0,0"/></StackPanel></Button>
     </UniformGrid>
     <Grid Grid.Row="2" Margin="0,0,0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="6" Height="6" Fill="#FF78D8A2" Margin="1,0,6,0"/><TextBlock Text="Model AI" Foreground="#FF9DA3B3" FontSize="10" VerticalAlignment="Center"/></StackPanel><ComboBox x:Name="ModelChoice" Grid.Column="1" Width="170" Height="25" SelectedIndex="0" Background="#FF171A22" Foreground="#FFE8EAF2" BorderBrush="#FF292D39" FontSize="10"><ComboBoxItem Content="qwen2.5-coder:3b"/><ComboBoxItem Content="llama3.2:3b"/><ComboBoxItem Content="llava:7b (vision)"/></ComboBox></Grid>
     <Border Grid.Row="3" CornerRadius="14" Background="#FF0E1016" BorderBrush="#FF292D39" BorderThickness="1" Padding="8"><ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock x:Name="ReplyText" TextWrapping="Wrap" Foreground="#FFBFC5D4" FontSize="11" Text="Halo! Aku siap membantu. Hubungkan Ollama untuk chat AI lokal. Kamu juga bisa membuka file kode untuk ditinjau." /></ScrollViewer></Border>
     <Grid Grid.Row="4" Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions><TextBox x:Name="PromptBox" Background="#FF171921" Foreground="#FFF5F6FA" BorderBrush="#FF292D39" CaretBrush="White" FontSize="11" Padding="9,7" VerticalContentAlignment="Center" TextWrapping="Wrap" AcceptsReturn="False" KeyDown="PromptBox_KeyDown"/><Button Grid.Column="1" Style="{StaticResource RoundButton}" Content="🎙" Margin="5,0,0,0" Click="Listen_Click" ToolTip="Dengarkan"/><Button Grid.Column="2" Style="{StaticResource SendButton}" Content="↑" Margin="5,0,0,0" Click="Send_Click" ToolTip="Kirim"/></Grid>
     <Grid Grid.Row="5"><TextBlock x:Name="ListeningText" Text="AI lokal · Ctrl+Shift+U" Foreground="#FF72798A" FontSize="9" VerticalAlignment="Bottom"/><TextBlock Text="Desktop companion" Foreground="#FF666D7D" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Bottom"/></Grid>
    </Grid>
   </Grid>
  </Border>
 </Grid>
</Window>
